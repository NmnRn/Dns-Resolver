#: dashboard/templates/dashboard/servers.html:49
msgid "İç port (Container) ~5 sn içinde canlı uygulanır."
msgstr "Internal port (Container) applies live within ~5 s."

#: dashboard/templates/dashboard/servers.html:50
msgid "ya da"
msgstr "or"

#: dashboard/templates/dashboard/servers.html:51
