# ============================================================================
#  Dns Python — .env ORNEK SABLONU
#  Gercek .env dosyasi git ile IZLENMEZ (.gitignore). Bu dosya yalniz referans.
#  Cogu deger install.sh (DB) + setup.sh (sunucu + guvenlik anahtarlari) tarafindan
#  OTOMATIK yazilir; elle kurulum yapiyorsan bunu kopyalayip doldur:
#      cp .env.example .env
#  Not: bu dosyaya GERCEK sir/parola/anahtar YAZMA — burasi repoda.
# ============================================================================

# --- Veritabani (install.sh yazar; MariaDB host'ta, dns-net uzerinden erisilir) ---
DB_HOST=172.27.17.1          # dns-net ag gecidi (host'un bu agdaki IP'si)
DB_PORT=3306
DB_USER=dns_user
DB_PASSWORD=                 # install.sh openssl ile uretir; ELLE koyarsan guclu sec
DB_NAME=dns_db

# --- DNS cozumleyici (container ici) ---
BIND_ADDRESS=0.0.0.0         # Docker icinde HEP 0.0.0.0 (host'a acilma ayri: EXTERNAL_*)
CONTAINER_UDP_PORT=5300      # duz DNS (Do53, UDP/TCP)
CONTAINER_HTTPS_PORT=44300   # DoH
CONTAINER_DOT_PORT=8853      # DoT
CONTAINER_DOQ_PORT=8530      # DoQ
ENABLE_UDP_SERVER=true
ENABLE_HTTPS_SERVER=false    # DoH  (sertifika ister; yoksa duz HTTP'ye duser)
ENABLE_DOT_SERVER=false      # DoT  (sertifika SART)
ENABLE_DOQ_SERVER=false      # DoQ  (sertifika SART)

# --- TLS (DoH/DoT/DoQ ORTAK kullanir) ---
CERT_FILE=/app/certificates/fullchain.pem
KEY_FILE=/app/certificates/privkey.pem
ALLOWED_HOST=dns.example.com # DoH Host header kontrolu (kendi domain'inle degistir)

# --- Host'a (disariya) acilacak portlar ---
# DIKKAT: bunlari acmak seni "acik resolver" yapabilir (DDoS amplification riski).
# Yalniz allow-list/rate-limit ile veya Cloudflare Tunnel arkasinda ac. Varsayilan: KAPALI
# (setup.sh port sorusuna "hayir" -> override dosyasi hic olusmaz).
EXTERNAL_UDP_PORT=53
EXTERNAL_HTTPS_PORT=443
EXTERNAL_DOT_PORT=853
EXTERNAL_DOQ_PORT=853

# --- Web panel (Django) ---
SITE_PORT=8444               # panel yalniz 127.0.0.1'e publish edilir (public DEGIL)
DJANGO_DEBUG=False           # PROD'da MUTLAKA False
DJANGO_ALLOWED_HOSTS=*       # public yayinliyorsan gercek domain'e daralt (or. dns.example.com)
DJANGO_SECURE_COOKIES=False  # paneli SALT HTTPS'te sunuyorsan True yap
DJANGO_CSRF_TRUSTED_ORIGINS= # ters proxy/domain arkasi form POST'u icin (or. https://dns.example.com)

# --- Guvenlik anahtarlari (setup.sh OTOMATIK uretir; elle uretmek istersen:) ---
# Django gizli anahtari — dolu oldugunda Django kendi uretmez (oncelik burada):
#   openssl rand -hex 64
DJANGO_SECRET_KEY=
# DNS gunlugu at-rest sifreleme (opsiyonel; bos = kapali). AES-SIV, base64(64 bayt):
#   openssl rand -base64 64 | tr -d '\n'
# UYARI: kaybolursa eski sifreli kayitlar cozulemez -> guvenli yerde YEDEKLE.
DNS_LOG_KEY=

# --- Bakim ---
LOG_DAYS=90                  # sorgu gunlugu saklama (gun); 0 = otomatik silme kapali
