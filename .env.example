# ============================================================================
#  Dns Python — .env ORNEK SABLONU  (yalniz SIR + DB + Django)
#  Gercek .env dosyasi git ile IZLENMEZ (.gitignore). Bu dosya yalniz referans.
#
#  >>> ONEMLI: Sunucu topolojisi (hangi metot acik + ic/dis portlar + cert yollari
#      + allowed_host + site_port) ARTIK BURADA DEGIL. O ayarlar:
#          config/servers.json   (setup.sh / start.sh / web panel yazar)
#      .env yalniz sir/DB/Django icindir.
#
#  Cogu deger install.sh (DB) + setup.sh (guvenlik anahtarlari) tarafindan
#  OTOMATIK yazilir; elle kurulumda:  cp .env.example .env  ve doldur.
#  Not: bu dosyaya GERCEK sir/parola/anahtar YAZMA — burasi repoda.
# ============================================================================

# --- Veritabani (install.sh yazar; MariaDB host'ta, dns-net uzerinden erisilir) ---
DB_HOST=172.27.17.1          # dns-net ag gecidi (host'un bu agdaki IP'si)
DB_PORT=3306
DB_USER=dns_user
DB_PASSWORD=                 # install.sh openssl ile uretir; ELLE koyarsan guclu sec
DB_NAME=dns_db

# --- Web panel (Django) ---
DJANGO_DEBUG=False           # PROD'da MUTLAKA False
DJANGO_ALLOWED_HOSTS=*       # >>> WEB PANELI domain'i (or. webpanel.example.com); public'te daralt
DJANGO_SECURE_COOKIES=False  # domain/tunel arkasinda (HTTPS) True yap
# Domain / Cloudflare Tunnel / ters proxy arkasindaysan ZORUNLU (bos ise form gonderimi
# CSRF 403 verir). Sema sart, sonda / yok; coklu icin virgul: https://a.com,https://b.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# HTTPS'te (domain/Cloudflare Tunnel) ONERILIR: tarayiciya "hep HTTPS kullan" der.
# SADECE HTTPS'te ac (HTTP'de kilitlenirsin). 31536000 = 1 yil.
DJANGO_HSTS_SECONDS=0
# Django'nun kendi HTTP->HTTPS yonlendirmesi (ters proxy zaten yapiyorsa kapali birak).
DJANGO_SSL_REDIRECT=False

# --- DNS resolver aciga cikarma (AMPLIFIKASYON UYARISI) ---
# UDP/53'u PUBLIC (0.0.0.0) actiginda + istemci ACL / rate-limit YOKKEN resolver
# "acik resolver"dir -> spoofed-kaynakli DNS amplifikasyon DDoS'una alet olabilir.
# Oneri: (1) UDP/53'u yalniz LAN'a bagla, disariya DoT/DoH/DoQ (baglanti-tabanli,
# spoof edilemez) sun; (2) ya da panel > Sorgu Ayarlari'ndan istemci ACL / rate-limit
# ver. DoT/DoH/DoQ amplifikasyona ACIK DEGILDIR (TLS/QUIC oturumu gerekir).

# --- Guvenlik anahtarlari (setup.sh OTOMATIK uretir; elle uretmek istersen:) ---
# Django gizli anahtari — dolu oldugunda Django kendi uretmez (oncelik burada):
#   openssl rand -hex 64
DJANGO_SECRET_KEY=
# DNS gunlugu at-rest sifreleme (opsiyonel; bos = kapali). AES-SIV, base64(64 bayt):
#   openssl rand -base64 64 | tr -d '\n'
# UYARI: kaybolursa eski sifreli kayitlar cozulemez -> guvenli yerde YEDEKLE.
DNS_LOG_KEY=

# --- Bakim ---
LOG_DAYS=90                  # sorgu gunlugu saklama (gun); 0 = otomatik silme kapali
